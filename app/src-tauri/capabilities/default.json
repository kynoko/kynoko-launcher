{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The settings window: the launcher's own page, and all its commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-set-default-browser",
    "allow-set-default-profile",
    "allow-set-app-browser",
    "allow-set-app-profile",
    "allow-set-associated",
    "allow-set-extension",
    "allow-set-shortcut-item",
    "allow-app-icon",
    "allow-set-shortcuts",
    "allow-check-catalogue",
    "allow-launch",
    "allow-remove-everything",
    "allow-open-default-apps",
    "allow-open-download",
    "allow-update-download",
    "allow-update-install",
    "allow-update-cancel"
  ]
}
