{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The settings window: the launcher's own page, and all its commands. It draws its own title bar, as a Kynoko window does: the own_window_* commands that move, minimize, maximize and close the window the page is in (closing the settings window hides it), and the launcher's icon to show in it.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-set-default-browser",
    "allow-set-default-profile",
    "allow-set-app-browser",
    "allow-set-app-profile",
    "allow-set-associated",
    "allow-set-extension",
    "allow-set-shortcut-item",
    "allow-answer-associations",
    "allow-app-icon",
    "allow-set-shortcuts",
    "allow-check-catalogue",
    "allow-launch",
    "allow-remove-everything",
    "allow-open-default-apps",
    "allow-open-download",
    "allow-update-download",
    "allow-update-install",
    "allow-update-cancel",
    "allow-update-now",
    "allow-set-assistant",
    "allow-account-sign-in",
    "allow-account-cancel",
    "allow-account-sign-out",
    "allow-own-window-drag",
    "allow-own-window-minimize",
    "allow-own-window-toggle-maximize",
    "allow-own-window-is-maximized",
    "allow-own-window-close",
    "core:app:allow-default-window-icon"
  ]
}
